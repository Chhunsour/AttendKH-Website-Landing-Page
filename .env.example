# Cloudways MySQL (never commit real values - .env* is gitignored)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Set true when connecting over a TLS-enabled remote connection
MYSQL_SSL=false
# Required when MYSQL_SSL=true; preserve newlines as \\n in platform env editors.
MYSQL_SSL_CA=
# Keep small: each serverless instance opens its own pool
MYSQL_POOL_SIZE=4

# Admin session signing key - generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=
# Optional separate rate-limit HMAC key; ADMIN_JWT_SECRET is used when omitted.
RATE_LIMIT_SECRET=

# One-time `npm run bootstrap:admin` inputs. Remove after the first admin exists.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

NEXT_PUBLIC_SITE_URL=https://attendkh.com
